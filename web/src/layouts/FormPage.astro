---
// Full-screen layout for Tally.so feedback forms (feedback, uninstall-feedback).
import BaseLayout from './BaseLayout.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  tallySrc: string;
  iframeId: string;
  canonicalPath: string;
}

const { title, description, tallySrc, iframeId, canonicalPath } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  includeAnalytics
  viewportContent="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0"
>
  <div class="banner">
    <div class="banner-info">
      <div class="banner-badge">100% Local &amp; Open Source</div>
      <div class="banner-text">
        <span>
          AI Chat Exporter is fully local, free, and open source. All contributions and feedback are
          warmly welcomed!
        </span>
        <span class="banner-subtext">
          You can directly fix issues or contribute on
          <a href={SITE.github} target="_blank" rel="noopener noreferrer">
            GitHub
          </a>
          , or submit your thoughts below and I will surely look into them.
        </span>
      </div>
    </div>
    <a href={SITE.github} target="_blank" rel="noopener noreferrer" class="github-link">
      <svg class="github-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
      </svg>
      <span>Contribute on GitHub</span>
    </a>
  </div>
  <div class="form-container">
    <!-- Appearance inside this iframe is 100% owned by Tally.so.
         Do not add transparentBackground, theme params, or CSS that
         paints through into the form. -->
    <iframe
      id={iframeId}
      data-tally-src={tallySrc}
      width="100%"
      height="100%"
      frameborder="0"
      marginheight="0"
      marginwidth="0"
      title={title}
    ></iframe>
  </div>

  <!-- Official Tally embed handler: lets tally.so own resizing/theme of the frame. -->
  <script async src="https://tally.so/widgets/embed.js"></script>
  <script is:inline>
    (function () {
      // Single form per page: resolve by data attribute so no build-time
      // ID interpolation is needed inside this inline script.
      const iframe = document.querySelector('iframe[data-tally-src]');
      if (!iframe) return;

      const ua = navigator.userAgent || '';
      let browser = 'Unknown';
      let browserVersion = '';

      if (navigator.userAgentData && Array.isArray(navigator.userAgentData.brands)) {
        const brandPriority = [
          { match: 'Microsoft Edge', name: 'Edge' },
          { match: 'Opera', name: 'Opera' },
          { match: 'Brave', name: 'Brave' },
          { match: 'Vivaldi', name: 'Vivaldi' },
          { match: 'Google Chrome', name: 'Chrome' },
          { match: 'Chromium', name: 'Chromium' },
        ];
        for (const item of brandPriority) {
          const b = navigator.userAgentData.brands.find(
            (x) => x.brand.includes(item.match) || x.brand === item.match,
          );
          if (b) {
            browser = item.name;
            browserVersion = b.version;
            break;
          }
        }
      }

      if (browser === 'Unknown' || !browserVersion) {
        const edgeMatch = ua.match(/Edg(?:e|A|iOS)?\/([0-9.]+)/);
        const oprMatch = ua.match(/(?:OPR|Opera)\/([0-9.]+)/);
        const vivaldiMatch = ua.match(/Vivaldi\/([0-9.]+)/);
        const samsungMatch = ua.match(/SamsungBrowser\/([0-9.]+)/);
        const chromeMatch = ua.match(/(?:Chrome|CriOS)\/([0-9.]+)/);
        const firefoxMatch = ua.match(/(?:Firefox|FxiOS)\/([0-9.]+)/);
        const safariMatch = ua.match(/Version\/([0-9.]+).*Safari/);

        if (oprMatch) {
          browser = 'Opera';
          browserVersion = oprMatch[1];
        } else if (edgeMatch) {
          browser = 'Edge';
          browserVersion = edgeMatch[1];
        } else if (vivaldiMatch) {
          browser = 'Vivaldi';
          browserVersion = vivaldiMatch[1];
        } else if (samsungMatch) {
          browser = 'Samsung Internet';
          browserVersion = samsungMatch[1];
        } else if (firefoxMatch) {
          browser = 'Firefox';
          browserVersion = firefoxMatch[1];
        } else if (chromeMatch) {
          browser = 'Chrome';
          browserVersion = chromeMatch[1];
        } else if (safariMatch) {
          browser = 'Safari';
          browserVersion = safariMatch[1];
        }
      }

      let os = 'Unknown';
      if (navigator.userAgentData && navigator.userAgentData.platform) {
        os = navigator.userAgentData.platform;
      }
      if (!os || os === 'Unknown') {
        if (/Win(?:dows )?([^;)]+)?/.test(ua)) os = 'Windows';
        else if (/Mac(?:intosh| OS X)/.test(ua)) os = 'macOS';
        else if (/Android/.test(ua)) os = 'Android';
        else if (/iPhone|iPad|iPod/.test(ua)) os = 'iOS';
        else if (/CrOS/.test(ua)) os = 'ChromeOS';
        else if (/Linux|X11/.test(ua)) os = 'Linux';
      }

      const pageParams = new URLSearchParams(window.location.search);
      const baseSrc = iframe.getAttribute('data-tally-src') || iframe.getAttribute('src') || '';
      const urlObj = new URL(baseSrc, window.location.href);

      urlObj.searchParams.set(
        'browser',
        pageParams.get('browser') && pageParams.get('browser') !== 'Other'
          ? pageParams.get('browser')
          : browser,
      );
      urlObj.searchParams.set(
        'browser_version',
        pageParams.get('browser_version') || browserVersion,
      );
      urlObj.searchParams.set('os', pageParams.get('os') || os);
      urlObj.searchParams.set('user_agent', ua);

      const appVer = pageParams.get('app_version') || pageParams.get('v');
      if (appVer) {
        urlObj.searchParams.set('app_version', appVer);
      }

      const finalUrl = urlObj.toString();
      iframe.setAttribute('data-tally-src', finalUrl);
      iframe.src = finalUrl;

      if (window.Tally && typeof window.Tally.loadEmbeds === 'function') {
        window.Tally.loadEmbeds();
      }
    })();
  </script>
  <style is:global>
    html,
    body {
      height: 100%;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .banner {
      flex: 0 0 auto;
      background: var(--bg-surface);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border-color);
      padding: 12px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      font-size: 13.5px;
    }
    .banner-info {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
    }
    .banner-badge {
      display: inline-flex;
      align-items: center;
      padding: 3px 10px;
      border-radius: 9999px;
      background: rgba(59, 130, 246, 0.12);
      border: 1px solid rgba(59, 130, 246, 0.25);
      color: #60a5fa;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.02em;
      white-space: nowrap;
    }
    .banner-text {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .banner-text span:first-child {
      font-weight: 500;
    }
    .banner-subtext {
      color: var(--text-secondary);
      font-size: 12.5px;
    }
    .banner-subtext a {
      color: #60a5fa;
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .banner-subtext a:hover {
      color: #93c5fd;
    }
    .github-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--text-primary);
      text-decoration: none;
      font-weight: 500;
      padding: 7px 14px;
      border-radius: 8px;
      background: rgba(148, 163, 184, 0.1);
      border: 1px solid rgba(148, 163, 184, 0.18);
      transition: all 0.2s ease;
      white-space: nowrap;
      font-size: 13px;
      flex-shrink: 0;
    }
    .github-link:hover {
      background: rgba(59, 130, 246, 0.18);
      border-color: rgba(59, 130, 246, 0.35);
      color: #60a5fa;
      transform: translateY(-1px);
    }
    .github-icon {
      width: 16px;
      height: 16px;
      fill: currentColor;
    }
    .form-container {
      flex: 1;
      position: relative;
      width: 100%;
    }
    iframe {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      border: 0;
      width: 100%;
      height: 100%;
      /* Do not set a background here: Tally.so owns the frame's theme. */
      /* Normal prevents our page color-scheme from leaking into the embed. */
      color-scheme: normal;
    }
    @media (max-width: 768px) {
      .banner {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
        padding: 12px 16px;
      }
      .banner-info {
        gap: 8px;
      }
      .github-link {
        width: 100%;
        justify-content: center;
      }
    }
  </style>
</BaseLayout>
