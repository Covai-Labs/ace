---
// Theme toggle: System / Light / Dark with localStorage persistence.
// Applied synchronously by the no-FOUC script in BaseLayout; this island-free
// script only wires up the buttons.
---

<div class="theme-toggle" role="group" aria-label="Theme switcher">
  <button
    type="button"
    data-theme="light"
    aria-label="Light theme"
    title="Light"
    aria-pressed="false"
  >
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="12" cy="12" r="5" />
      <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
    </svg>
  </button>
  <button type="button" data-theme="dark" aria-label="Dark theme" title="Dark" aria-pressed="false">
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
    </svg>
  </button>
  <button
    type="button"
    data-theme="system"
    aria-label="System theme (follow OS)"
    title="System"
    aria-pressed="false"
  >
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
      <line x1="8" y1="21" x2="16" y2="21" />
      <line x1="12" y1="17" x2="12" y2="21" />
    </svg>
  </button>
</div>

<script is:inline>
  (function () {
    const root = document.documentElement;
    const buttons = Array.from(document.querySelectorAll('.theme-toggle button[data-theme]'));
    if (!buttons.length) return;

    function getStored() {
      try {
        const t = localStorage.getItem('decant-core-theme');
        return t === 'dark' || t === 'light' ? t : 'system';
      } catch (e) {
        return 'system';
      }
    }

    function apply(theme) {
      if (theme === 'light' || theme === 'dark') {
        root.dataset.theme = theme;
      } else {
        delete root.dataset.theme; // fall back to prefers-color-scheme in CSS
      }
      try {
        localStorage.setItem('decant-core-theme', theme);
      } catch (e) {
        /* private mode */
      }
      buttons.forEach((b) => {
        b.setAttribute('aria-pressed', String(b.dataset.theme === theme));
      });
    }

    apply(getStored());

    buttons.forEach((b) => {
      b.addEventListener('click', () => apply(b.dataset.theme));
    });
  })();
</script>
