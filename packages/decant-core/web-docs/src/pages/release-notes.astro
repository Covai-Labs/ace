---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { renderMarkdown } from '../utils/markdown';

const description =
  'Release notes for decant-core — every published version, generated from the changelog.';

// Resolved from the build working directory (web-docs/); the compiled page
// chunk lives elsewhere, so import.meta.url is not a stable anchor.
const changelogRaw = readFileSync(resolve(process.cwd(), '../CHANGELOG.md'), 'utf8');
const changelogHtml = renderMarkdown(changelogRaw);
---

<BaseLayout
  title="Release notes — decant-core"
  description={description}
  canonicalPath="/release-notes.html"
>
  <Header />
  <main class="page-section shell release-notes">
    <span class="eyebrow">Changelog</span>
    <h1>Release notes.</h1>
    <p class="lede">
      Every published version of decant-core, newest first. This page is generated from{' '}
      <code>CHANGELOG.md</code> at build time — the canonical history lives in{' '}
      <a
        href="https://github.com/Covai-Labs/decant/releases"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub Releases
      </a>
      .
    </p>
    <div class="changelog-body" set:html={changelogHtml} />
  </main>
  <Footer />
</BaseLayout>

<style>
  .release-notes .changelog-body h2 {
    margin-top: 56px;
    padding-top: 26px;
    border-top: 1px solid var(--border);
    font-size: clamp(1.4rem, 3vw, 2rem);
  }

  .release-notes .changelog-body h3 {
    margin-top: 30px;
    color: var(--wine);
    font: 600 0.85rem var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .release-notes .changelog-body ul {
    list-style: disc;
    padding-left: 24px;
    margin: 12px 0 0;
  }

  .release-notes .changelog-body li {
    color: var(--muted);
    font-size: 0.95rem;
    margin-bottom: 8px;
  }

  .release-notes .changelog-body li strong {
    color: var(--text);
  }

  .release-notes .changelog-body a {
    color: var(--wine);
  }

  .release-notes .changelog-body code {
    font: 0.82rem var(--mono);
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1px 6px;
  }

  .release-notes .changelog-body p {
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
