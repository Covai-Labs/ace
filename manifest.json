        "*://www.google.ca/*",
        "*://www.google.com.au/*",
        "*://www.google.de/*",
        "*://www.google.fr/*"
      ],
      "all_frames": true,
      "js": ["content/main.js"],
      "run_at": "document_idle",
      "type": "module"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/main.js",
        "content/loader.js",
        "content/claude_react_reader.js",
        "content/chatgpt_helper.js",
        "content/lib/*.js",
        "content/utils/*.js",
        "content/parsers/*.js",
        "content/formatters/*.js",
        "schemas/*.json",
        "_locales/*"
      ],
