        "*://www.m365.cloud.microsoft/*",
        "*://www.bing.com/*",
        "*://bing.com/*",
        "*://edgeservices.bing.com/*",
        "*://lumo.proton.me/*",
        "*://joyland.ai/*",
        "*://www.joyland.ai/*",
        "*://chub.ai/*",
        "*://www.chub.ai/*",
