{
  "name": "ai-chat-exporter",
  "version": "1.22.0",
  "license": "MPL-2.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "test": "node --test tests/*.test.*",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "lint": "eslint .",
    "lint:ext": "web-ext lint --source-dir .output/firefox-mv3",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "linkedom": "^0.18.13",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "decant-core": "^1.16.0",
    "dompurify": "^3.4.14",
    "html2canvas": "^1.4.1",
    "katex": "^0.19.0",
    "loglevel": "^1.9.2",
    "prismjs": "^1.30.0"
  }
}
